#!/usr/bin/env bash
# Curator Step 1: remove done and expired Curator sessions, expired Planner
# sessions, and inactive sessions left over from closed cycles.
. "$(dirname "$0")/lib.sh"

self=${LOOP_SESSION:?LOOP_SESSION is not set}
protected=$(protected_branches)
cur=$(current_cycle)

"$MSM" session list |
  jq -r --arg self "$self" --argjson cur "$cur" '.[]
    | select(.name != $self and .status != "active")
    | select(.role == "curator"
        or (.role == "planner" and .status == "expired")
        or (.cycle != null and .role != "curator"
            and ($cur == null or .cycle < $cur.id
                 or (.cycle == $cur.id and $cur.status == "closed"))))
    | .name' |
  while read -r name; do
    remove_session "$name" "$protected"
    echo "removed $name"
  done
