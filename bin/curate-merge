#!/usr/bin/env bash
# Curator Step 3: merge given sessions into the Curator session, in every repo.
# Usage: curate-merge <session>...
# Exit: 0 clean. 1 at least one repo has unresolved conflicts; the files are
# listed on stdout as "repo\tpath" and left in the worktree for the agent to fix.
. "$(dirname "$0")/lib.sh"

self=${LOOP_SESSION:?LOOP_SESSION is not set}
dir="$LOOP_ROOT/$self"
[ "$#" -gt 0 ] || die "usage: curate-merge <session>..."

rc=0
for name in "$@"; do
  for repo in $(repos); do
    git -C "$CENTRAL/$repo" show-ref --verify --quiet "refs/heads/$name" || continue
    if ! git -C "$dir/$repo" merge --no-edit --no-ff "$name" >/dev/null 2>&1; then
      git -C "$dir/$repo" diff --name-only --diff-filter=U | while read -r f; do
        printf '%s\t%s\n' "$repo" "$f"
      done
      rc=1
    fi
  done
done
exit "$rc"
