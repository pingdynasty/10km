# 10km loop configuration. Sourced by the scripts as shell.
# Each setting can be overridden by an environment variable of the same name.
# Scripts read the copy in the central loop worktree, so changes take effect
# once a Curator has merged them into main.

# Project repos: "name" creates an empty repo, "name=url" clones one.
PROJECT_REPOS="${PROJECT_REPOS-project}"

# Seconds between Dispatcher passes.
DISPATCH_INTERVAL="${DISPATCH_INTERVAL-60}"
# Seconds before an agent session is timed out, and the grace period before SIGKILL.
SESSION_TIMEOUT="${SESSION_TIMEOUT-3600}"
KILL_GRACE="${KILL_GRACE-10}"
# Seconds between Auditor runs.
AUDITOR_INTERVAL="${AUDITOR_INTERVAL-86400}"
# Maximum number of Workers active at once.
MAX_WORKERS="${MAX_WORKERS-4}"
# Backlog size at which the Planner prioritises or prunes.
BACKLOG_SIZE="${BACKLOG_SIZE-50}"

# Notification command, run with the message as $1. Empty: append to NOTIFICATIONS.md.
# Example: NOTIFY_CMD='apprise -b "$1" "$APPRISE_URL"'
NOTIFY_CMD="${NOTIFY_CMD-}"

# Agent command, run with $SESSION and $PROMPT set, from the session directory.
# Override per role with PLANNER_AGENT, WORKER_AGENT, CURATOR_AGENT, AUDITOR_AGENT.
[ -n "${LOOP_AGENT+x}" ] || LOOP_AGENT='claude --no-session-persistence --dangerously-skip-permissions -p "$PROMPT"'
# LOOP_AGENT='codex exec "$PROMPT"'
# LOOP_AGENT='kiro-cli chat --trust-tools --no-interactive "$PROMPT"'
