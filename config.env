# 10km loop configuration. Sourced by the scripts as shell.
# Each setting can be overridden by an environment variable of the same name.
# Scripts read the copy in the central loop worktree, so changes take effect
# once a Curator has merged them into main.

# Project repos: "name" creates an empty repo, "name=url" clones one.
PROJECT_REPOS="${PROJECT_REPOS-project}"

# Seconds between Dispatcher passes.
DISPATCH_INTERVAL="${DISPATCH_INTERVAL-60}"
# Seconds before an agent session times out, and grace before SIGKILL.
SESSION_TIMEOUT="${SESSION_TIMEOUT-3600}"
KILL_GRACE="${KILL_GRACE-10}"
# Maximum Workers active at once.
MAX_WORKERS="${MAX_WORKERS-4}"
# Backlog size at which the Planner prioritises or prunes.
BACKLOG_SIZE="${BACKLOG_SIZE-50}"

# Auditor trigger: launch when EITHER limit is reached. The first Auditor runs
# only after at least one cycle has been curated.
AUDIT_CYCLES_LIMIT="${AUDIT_CYCLES_LIMIT-5}"
AUDITOR_INTERVAL="${AUDITOR_INTERVAL-86400}"

# Stop the loop (reason "idle") after this many consecutive empty cycles.
IDLE_CYCLE_LIMIT="${IDLE_CYCLE_LIMIT-3}"

# Validation gates, run by the Curator in Step 6, newline-separated. Each line
# is a shell command; the Curator runs it from the loop worktree in every repo
# where the gate is relevant. Non-zero exit means the gate failed.
VALIDATION_GATES="${VALIDATION_GATES-}"
# Example:
#   VALIDATION_GATES=$'brazil-build\nbrazil-build test'

# Notification command, run with the message as $1. Empty: append to NOTIFICATIONS.md.
NOTIFY_CMD="${NOTIFY_CMD-}"

# Agent command, run with SESSION, LOOP_SESSION and PROMPT_FILE set in the
# environment, from the session directory. The prompt is a file to keep it
# off the command line (Linux caps a single argument at ~128 KB).
# Override per role with PLANNER_AGENT, WORKER_AGENT, CURATOR_AGENT, AUDITOR_AGENT.
[ -n "${LOOP_AGENT+x}" ] || LOOP_AGENT='claude --no-session-persistence --dangerously-skip-permissions < "$PROMPT_FILE"'
# LOOP_AGENT='codex exec "$(cat "$PROMPT_FILE")"'
