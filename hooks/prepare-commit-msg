#!/bin/sh
# Add a Loop-Session trailer to every commit, from LOOP_SESSION or the branch.
session=${LOOP_SESSION:-$(git symbolic-ref --quiet --short HEAD)}
if [ -n "$session" ] && [ "$session" != main ]; then
  git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Loop-Session: $session" "$1" || exit 1
fi
