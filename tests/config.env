# Test config for 10km's own tests, selected with LOOP_CONFIG (tests/testenv.py
# sets it for every test process). Sourced as shell, like config.env.
#
# Every agent command fails loudly unless a test sets its own fake, so no test
# can launch a real agent harness (claude, codex, kiro-cli) by accident. A test
# that sets LOOP_AGENT gets it for every role, as in the code's config.env.
#
# The other settings come from the test loop's own config.env
# ($LOOP_ROOT/central/loop/config.env, a copy of the code's that tests may edit),
# or, before a test loop exists, from the code's config.env next to tests/.

__tenkm_fail="is not set; this test must set a fake agent' >&2; exit 97"
if [ -z "${LOOP_AGENT+x}" ]; then
  LOOP_AGENT="echo '10km tests: LOOP_AGENT $__tenkm_fail"
  [ -n "${PLANNER_AGENT+x}" ] || PLANNER_AGENT="echo '10km tests: PLANNER_AGENT $__tenkm_fail"
  [ -n "${WORKER_AGENT+x}" ] || WORKER_AGENT="echo '10km tests: WORKER_AGENT $__tenkm_fail"
  [ -n "${CURATOR_AGENT+x}" ] || CURATOR_AGENT="echo '10km tests: CURATOR_AGENT $__tenkm_fail"
  [ -n "${AUDITOR_AGENT+x}" ] || AUDITOR_AGENT="echo '10km tests: AUDITOR_AGENT $__tenkm_fail"
fi
[ -n "${OPERATOR_AGENT+x}" ] || OPERATOR_AGENT="echo '10km tests: OPERATOR_AGENT $__tenkm_fail"
unset __tenkm_fail

__tenkm_base="${LOOP_ROOT:-/nonexistent}/central/loop/config.env"
[ -f "$__tenkm_base" ] || __tenkm_base="${BASH_SOURCE[0]%/*}/../config.env"
# shellcheck source=/dev/null
. "$__tenkm_base"
unset __tenkm_base
