# The settings the tests assume: 10km's defaults from config.env. tests/config.env
# sources this before the loop's config.env, so a fork's own settings (time-outs,
# audit schedule, gates, ...) don't change what the tests see. Keep it in step
# with config.env; the tests' own settings and the environment still override it.
DISPATCH_INTERVAL="${DISPATCH_INTERVAL-60}"
SESSION_TIMEOUT="${SESSION_TIMEOUT-3600}"
PLANNER_TIMEOUT="${PLANNER_TIMEOUT-}"
WORKER_TIMEOUT="${WORKER_TIMEOUT-}"
CURATOR_TIMEOUT="${CURATOR_TIMEOUT-}"
AUDITOR_TIMEOUT="${AUDITOR_TIMEOUT-}"
KILL_GRACE="${KILL_GRACE-10}"
START_GRACE="${START_GRACE-180}"
MAX_TASKS_PER_CYCLE="${MAX_TASKS_PER_CYCLE-0}"
MAX_CONCURRENT_AGENTS="${MAX_CONCURRENT_AGENTS-6}"
BACKLOG_SIZE="${BACKLOG_SIZE-50}"
AUDIT_TIME="${AUDIT_TIME-07:00}"
AUDIT_TIMEZONE="${AUDIT_TIMEZONE-UTC}"
AUDIT_CYCLES_LIMIT="${AUDIT_CYCLES_LIMIT-0}"
IDLE_CYCLE_LIMIT="${IDLE_CYCLE_LIMIT-3}"
WORKER_GATES="${WORKER_GATES-}"
VALIDATION_GATES="${VALIDATION_GATES-}"
GATE_WAIT="${GATE_WAIT-540}"
NOTIFY_CMD="${NOTIFY_CMD-}"
PROJECT_NAME="${PROJECT_NAME-}"
LAUNCHER="${LAUNCHER-process}"
