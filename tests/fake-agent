#!/usr/bin/env bash
# Fake agent for tests: does the minimum each role must do, using real msm and git.
# Use as LOOP_AGENT=fake-agent.
#
# Behaviour is chosen per session with FAKE_<NAME>, FAKE_<ROLE#> or FAKE_<ROLE>,
# the first one set, e.g. FAKE_CYCLE1_WORKER2, FAKE_WORKER2, FAKE_WORKER:
#   ok        (default) do the role's work and set the session done
#   slow      the same, after sleeping FAKE_DELAY seconds (default 2)
#   hang      never finish (a Worker commits its work first)
#   die       exit 1 without setting the session done (a Worker commits first)
#   conflict  Worker: write its session name to shared.txt instead of <task>.txt
#   broken    Worker: also commit broken.txt
# FAKE_TASKS: the Planner's task shortnames, space-separated (default "hello";
# set but empty plans an empty cycle). A Worker commits in every project repo.
# The Curator merges done sessions one by one, rejects a Worker whose merge
# conflicts or fails `gate validation`, and backlogs rejected and expired Workers
# with their branch. At Assess it escalates `idle` once `empty_cycles` reaches
# IDLE_CYCLE_LIMIT, and at Exit stops the loop if a blocking escalation is open.
set -euo pipefail
. "$(dirname "$0")/../bin/lib.sh"
s=$SESSION
dir="$LOOP_ROOT/$s"
projects=$(repos | sed 1d)

key=$(tr 'a-z-' 'A-Z_' <<<"${s%-*}")  # CYCLE1_WORKER2, AUDITOR1
numbered=${key#CYCLE*_}               # WORKER2
mode=
for v in "FAKE_$key" "FAKE_$numbered" "FAKE_${numbered%%[0-9]*}"; do
  [ -n "${!v-}" ] && { mode=${!v}; break; }
done
mode=${mode:-ok}

# Where a hanging or dying agent stops.
give_up() {
  case $mode in
    hang) sleep 600; exit 0 ;;
    die) exit 1 ;;
  esac
}

backlog() {  # backlog <session> <why>: keep a Worker's branch for later
  "$MSM" issue create "$(jq -n --arg s "$s" --arg w "$1" --arg why "$2" \
    '{type: "backlog", title: "\($why): \($w)", description: "\($why) work on branch \($w)",
      owner_session: $s, assignee_role: "planner", severity: "low",
      urgent_if: "never", branch: $w}')" >/dev/null
}

validate() {  # gate validation, waiting while it runs
  local rc=3
  while [ "$rc" = 3 ]; do rc=0; gate validation >/dev/null 2>&1 || rc=$?; done
  [ "$rc" = 0 ]
}

[ "$mode" = slow ] && sleep "${FAKE_DELAY:-2}"

case $s in
  *-planner-*)
    give_up
    "$MSM" cycle create "$(jq -n --arg s "$s" --arg names "${FAKE_TASKS-hello}" \
      '{planner_session: $s, headline: "smoke",
        tasks: [$names | split(" ")[] | select(. != "")
                | {shortname: ., instructions: "add \(.)", branch: $s}]}')" >/dev/null
    "$MSM" session done "$s" >/dev/null ;;
  *-worker*)
    task=$("$MSM" task get --session "$s")
    name=$(jq -r .shortname <<<"$task")
    file=$name.txt text=$name
    [ "$mode" = conflict ] && file=shared.txt text=$s
    for project in $projects; do
      git -C "$dir/$project" rebase -q "$(jq -r .branch <<<"$task")"
      echo "$text" >"$dir/$project/$file"
      git -C "$dir/$project" add "$file"
      if [ "$mode" = broken ]; then
        echo broken >"$dir/$project/broken.txt"
        git -C "$dir/$project" add broken.txt
      fi
      git -C "$dir/$project" commit -q -m "Add $name"
    done
    "$MSM" task update --session "$s" "{\"branch\": \"$s\"}" >/dev/null
    give_up
    "$MSM" task update --session "$s" "{\"report\": \"added $name\"}" >/dev/null
    "$MSM" session done "$s" >/dev/null ;;
  auditor*)
    give_up
    echo "- smoke learning" >>"$dir/loop/LEARNINGS.md"
    git -C "$dir/loop" add LEARNINGS.md
    git -C "$dir/loop" commit -q -m "Add learning"
    "$MSM" audit create '{"period": {"from": "start", "to": "now"}, "summary": "ok"}' >/dev/null
    "$MSM" session done "$s" >/dev/null ;;
  *-curator-*)
    give_up
    curate-prepare >/dev/null
    selected=$(curate-select)
    names() { jq -r ".[] | select($1) | .name" <<<"$selected" | tr '\n' ' '; }
    items=$(names '.role != "worker" and .status == "done"')
    accepted= rejected=
    for w in $(names '.role == "worker" and .status == "done"'); do
      # shellcheck disable=SC2086
      if curate-merge $items "$w" >/dev/null && validate; then
        items="$items $w" accepted="$accepted $w"
      else
        rejected="$rejected $w"
        backlog "$w" Rejected
      fi
    done
    # shellcheck disable=SC2086
    curate-merge $items >/dev/null  # without the rejected ones
    for w in $(names '.role == "worker" and .status == "expired"'); do
      backlog "$w" Expired
    done
    empty=$("$MSM" loop get | jq .empty_cycles)
    if [ -n "${IDLE_CYCLE_LIMIT-}" ] && [ "$empty" -ge "$IDLE_CYCLE_LIMIT" ]; then
      "$MSM" issue create "$(jq -n --arg s "$s" --arg n "$empty" \
        '{type: "escalation", title: "idle: \($n) empty cycles", description: "idle",
          owner_session: $s, assignee_role: "operator", severity: "blocking"}')" >/dev/null
    fi
    # shellcheck disable=SC2086
    curate-publish --report smoke --accepted $accepted --rejected $rejected >/dev/null
    curate-cleanup >/dev/null
    blocking=$("$MSM" issue list '{"status": "open", "severity": "blocking", "assignee_role": "operator"}' | jq length)
    [ "$blocking" -gt 0 ] && "$MSM" loop stop blocked >/dev/null
    "$MSM" session done "$s" >/dev/null ;;
esac
